{
  "name": "refit-monorepo",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "bun run --filter refit-web dev",
    "build": "bun run --filter '*' build",
    "typecheck": "tsc -b",
    "test": "bun test",
    "lint": "eslint .",
    "cli": "bun --conditions=source packages/refit-cli/src/refit.ts",
    "preview": "bun run --filter refit-web preview"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.1.2",
    "eslint": "9",
    "eslint-config-the-only-perfect": "^2.1.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0"
  }
}
